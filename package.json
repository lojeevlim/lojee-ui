{
  "name": "lojee-ui",
  "version": "0.1.0-alpha.0",
  "description": "React + TypeScript UI component library styled with Tailwind v4 — ships auto-generated Web Components alongside the React components, with a built-in demo/docs site.",
  "license": "MIT",
  "author": "lojeevlim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lojeevlim/lojee-ui.git"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "web-components",
    "tailwindcss"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./elements": {
      "import": "./dist/elements.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:elements": "vite build --config vite.elements.config.ts",
    "build:pkg": "npm run build:lib && npm run build:elements",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build:pkg",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@r2wc/react-to-web-component": "^2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
